# Copy this file to .env and fill in real values.
# .env is in .gitignore — it must NEVER be committed to git.

# A long, random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-this-with-a-real-random-value

# True while developing on your own machine. Set to False before this
# is ever reachable by anyone else (a shared demo, a deployed server).
DJANGO_DEBUG=True

# Comma-separated hostnames/IPs this server will answer for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection — match whatever you created locally, e.g.:
#   createdb kenyas_trivia
DB_NAME=kenyas_trivia
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
